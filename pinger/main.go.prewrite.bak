package main

import (
	"bytes"
	"context"
	"encoding/json"
	"fmt"
	"log"
	"math"
	"net/http"
	"net/url"
	"os"
	"strconv"
	"sync"
	"time"

	"github.com/castai/promwrite"
	probing "github.com/prometheus-community/pro-bing"
)

type target struct {
	addr     string
	provider string
	family   string
	role     string
}

var targets = []target{
	{"8.8.8.8", "google", "ipv4", "primary"},
	{"8.8.4.4", "google", "ipv4", "secondary"},
	{"2001:4860:4860::8888", "google", "ipv6", "primary"},
	{"2001:4860:4860::8844", "google", "ipv6", "secondary"},
	{"1.1.1.1", "cloudflare", "ipv4", "primary"},
	{"1.0.0.1", "cloudflare", "ipv4", "secondary"},
	{"2606:4700:4700::1111", "cloudflare", "ipv6", "primary"},
	{"2606:4700:4700::1001", "cloudflare", "ipv6", "secondary"},
}

// sample is one per-second reachability observation for a target.
type sample struct {
	up  bool
	rtt float64 // RTT in milliseconds; only meaningful when up.
}

func main() {
	mimirURL := os.Getenv("MIMIR_URL")
	if mimirURL == "" {
		mimirURL = "http://mimir:9009/api/v1/push"
	}
	lokiURL := os.Getenv("LOKI_URL")
	if lokiURL == "" {
		lokiURL = "http://loki:3100/loki/api/v1/push"
	}
	client := promwrite.NewClient(mimirURL)

	log.Printf("pinger starting: %d targets, remote_write -> %s, loki -> %s", len(targets), mimirURL, lokiURL)

	// Wait for Mimir to be ready before pushing so the logs stay clean.
	waitForMimir(mimirURL)

	// One long-lived goroutine per target. They tick concurrently (all 8 are
	// probed every second in parallel), yet each target's samples are pushed
	// sequentially from its own goroutine, which keeps per-series timestamps
	// monotonic and avoids Mimir out-of-order rejections. A slow/timing-out
	// target only delays its own loop, never the others.
	var wg sync.WaitGroup
	for _, t := range targets {
		wg.Add(1)
		go func(t target) {
			defer wg.Done()
			runTarget(client, lokiURL, t)
		}(t)
	}
	wg.Wait()
}

func runTarget(client *promwrite.Client, lokiURL string, t target) {
	results := make(chan sample, 8)

	// Producer: a single long-lived pinger, reused for the whole process
	// lifetime. Reusing one ICMP socket per target — instead of creating and
	// tearing down a raw socket every second — avoids the spurious per-second
	// timeouts the churn induced on the Docker Desktop / WSL2 network stack.
	// pingLoop only returns on a socket setup error, so restart it if that
	// ever happens.
	go func() {
		for {
			if err := pingLoop(t.addr, results); err != nil {
				log.Printf("ping loop for %s exited: %v (restarting)", t.addr, err)
			}
			time.Sleep(time.Second)
		}
	}()

	// Consumer: serialize all Mimir/Loki writes for this target so per-series
	// timestamps stay monotonic and network I/O never blocks the ping loop.
	//
	// prev holds this target's last observed state. It stays nil until the very
	// first sample so that the initial observation only records the baseline and
	// does not emit a "state change" log on every process (re)start.
	var prev *bool
	for s := range results {
		pushMetrics(client, t, s)
		if prev == nil {
			up := s.up
			prev = &up
			continue
		}
		if *prev != s.up {
			pushLokiEvent(lokiURL, t, stateName(*prev), stateName(s.up))
			*prev = s.up
		}
	}
}

const (
	// A target is "up" if a reply arrived within this window. Being a little
	// over 2 intervals, it tolerates the occasional single dropped packet
	// (normal on the public internet) without flapping, while still flagging a
	// real outage within ~3s. This debounce, together with reusing one socket
	// per target, is what keeps a healthy link from emitting spurious events.
	upWindow = 2500 * time.Millisecond
	// Delay the first verdict so a reply (if the target is reachable) has time
	// to land. This makes the very first emitted sample the target's true state,
	// so the consumer records a correct baseline instead of logging a bogus
	// down->up transition on every startup.
	baselineGrace = 3 * time.Second
	// maxPlausibleRttMs bounds a believable round-trip time. pro-bing computes
	// RTT as receivedAt.Sub(sendTime), and the sendTime it decodes from the
	// packet payload carries no monotonic-clock reading, so a backward wall-clock
	// step between send and receive (NTP / host sleep-resume / Docker-Desktop time
	// sync) can make the RTT negative — and a forward step can make it absurdly
	// large. A value outside [0, maxPlausibleRttMs] is such an artifact, not a
	// real measurement, so it is discarded (see OnRecv).
	maxPlausibleRttMs = 60000 // 60s
)

// staleNaN is the IEEE-754 NaN payload that Prometheus and Mimir interpret as a
// staleness marker (github.com/prometheus/prometheus/model/value.StaleNaN). Sent
// as a sample value over remote_write, it ends the series at that timestamp, so a
// query shows a gap from then on instead of carrying the last real value forward
// for the lookback window (5m by default).
var staleNaN = math.Float64frombits(0x7ff0000000000002)

// pingLoop runs one persistent pinger for addr, sending an echo every second on
// a reused socket, and emits one reachability sample per second. Reachability
// is judged purely on "how recently did a reply arrive", independent of whether
// each send succeeded — so both an unreachable target (sends succeed, no reply)
// and a local network drop (sends fail, no reply) are detected. Reusing a
// single socket per target avoids the spurious per-second timeouts that the old
// create-a-socket-per-probe design induced on the Docker Desktop / WSL2 stack.
func pingLoop(addr string, results chan<- sample) error {
	pinger, err := probing.NewPinger(addr)
	if err != nil {
		return err
	}
	pinger.SetPrivileged(true) // raw ICMP socket; requires NET_RAW capability
	pinger.Interval = time.Second
	pinger.RecordRtts = false // long-running: don't accumulate RTT history

	var mu sync.Mutex
	var lastRecv time.Time // zero until the first reply for this loop
	var lastRtt float64
	pinger.OnRecv = func(pkt *probing.Packet) {
		rtt := float64(pkt.Rtt.Microseconds()) / 1000.0
		// Discard replies with an implausible RTT instead of recording them. The
		// reply itself is genuine (it already passed pro-bing's ICMP-ID and UUID
		// checks), but a wall-clock adjustment between send and receive can make
		// the derived RTT negative or absurdly large (see maxPlausibleRttMs). Such
		// a value must neither be pushed as a metric nor refresh lastRecv — leaving
		// the up-window untouched is safe because the upWindow debounce already
		// tolerates the occasional missed reply.
		if rtt < 0 || rtt > maxPlausibleRttMs {
			return
		}
		mu.Lock()
		lastRecv = time.Now()
		lastRtt = rtt
		mu.Unlock()
	}

	done := make(chan struct{})
	go func() {
		time.Sleep(baselineGrace)
		emit := func() {
			mu.Lock()
			up := !lastRecv.IsZero() && time.Since(lastRecv) < upWindow
			rtt := lastRtt
			mu.Unlock()
			s := sample{up: up}
			if up {
				s.rtt = rtt
			}
			// Non-blocking: never let a slow downstream write stall this loop.
			// A dropped sample only skips one Mimir data point.
			select {
			case results <- s:
			default:
			}
		}
		emit() // baseline
		ticker := time.NewTicker(time.Second)
		defer ticker.Stop()
		for {
			select {
			case <-done:
				return
			case <-ticker.C:
				emit()
			}
		}
	}()

	err = pinger.Run() // blocks until a fatal error (Count is unset = infinite)
	close(done)
	return err
}

func stateName(up bool) string {
	if up {
		return "up"
	}
	return "down"
}

// waitForMimir blocks until Mimir's /ready endpoint returns 200, so the first
// remote_write does not fail with connection-refused / not-ready errors.
func waitForMimir(pushURL string) {
	readyURL := "http://mimir:9009/ready"
	if u, err := url.Parse(pushURL); err == nil && u.Host != "" {
		readyURL = u.Scheme + "://" + u.Host + "/ready"
	}
	c := &http.Client{Timeout: 3 * time.Second}
	for {
		resp, err := c.Get(readyURL)
		if err == nil {
			_ = resp.Body.Close()
			if resp.StatusCode == http.StatusOK {
				log.Printf("mimir is ready (%s)", readyURL)
				return
			}
		}
		time.Sleep(2 * time.Second)
	}
}

func pushMetrics(client *promwrite.Client, t target, s sample) {
	// Timestamp at push time so successive samples for this series are strictly
	// increasing in time (pushes for a target are serialized by its consumer).
	ts := time.Now()

	labels := func(name string) []promwrite.Label {
		return []promwrite.Label{
			{Name: "__name__", Value: name},
			{Name: "target", Value: t.addr},
			{Name: "provider", Value: t.provider},
			{Name: "family", Value: t.family},
			{Name: "role", Value: t.role},
		}
	}

	upVal := 0.0
	if s.up {
		upVal = 1.0
	}

	// ping_duration_milliseconds is emitted on every tick: a real measurement
	// while up, and an explicit staleness marker while down. Emitting the marker
	// (instead of simply omitting the series when down) ends the series at this
	// timestamp so a downed target's last RTT is not carried forward for the query
	// lookback window (~5m) — it shows a clean gap for the duration of the outage.
	durVal := staleNaN
	if s.up {
		durVal = s.rtt
	}

	series := []promwrite.TimeSeries{
		{
			Labels: labels("ping_up"),
			Sample: promwrite.Sample{Time: ts, Value: upVal},
		},
		{
			Labels: labels("ping_duration_milliseconds"),
			Sample: promwrite.Sample{Time: ts, Value: durVal},
		},
	}

	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
	defer cancel()
	if _, err := client.Write(ctx, &promwrite.WriteRequest{TimeSeries: series}); err != nil {
		log.Printf("remote_write failed for %s: %v", t.addr, err)
	}
}

// pushLokiEvent sends a single state-change log line to Loki's push API. It is
// called only when a target's reachability actually flips (not on the first
// observation), so a healthy target produces no log noise.
func pushLokiEvent(lokiURL string, t target, from, to string) {
	line := fmt.Sprintf("state changed: %s -> %s (target=%s provider=%s)", from, to, t.addr, t.provider)
	payload := map[string]any{
		"streams": []map[string]any{
			{
				"stream": map[string]string{
					"target":   t.addr,
					"provider": t.provider,
					"family":   t.family,
					"role":     t.role,
					"event":    "state_change",
				},
				"values": [][]string{
					{strconv.FormatInt(time.Now().UnixNano(), 10), line},
				},
			},
		},
	}

	body, err := json.Marshal(payload)
	if err != nil {
		log.Printf("loki marshal failed for %s: %v", t.addr, err)
		return
	}

	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
	defer cancel()
	req, err := http.NewRequestWithContext(ctx, http.MethodPost, lokiURL, bytes.NewReader(body))
	if err != nil {
		log.Printf("loki request build failed for %s: %v", t.addr, err)
		return
	}
	req.Header.Set("Content-Type", "application/json")

	resp, err := http.DefaultClient.Do(req)
	if err != nil {
		log.Printf("loki push failed for %s: %v", t.addr, err)
		return
	}
	defer func() { _ = resp.Body.Close() }()
	if resp.StatusCode >= 300 {
		log.Printf("loki push for %s returned status %d", t.addr, resp.StatusCode)
		return
	}
	log.Printf("state change logged to loki: %s %s", t.addr, line)
}
