// Grafana Alloy relay for nethealth.
//
//   pinger --OTLP/gRPC(metrics+logs)--> Alloy
//     metrics: otelcol.receiver.otlp -> otelcol.exporter.prometheus
//              -> prometheus.relabel (drop job/instance) -> prometheus.remote_write -> Mimir
//     logs:    otelcol.receiver.otlp -> otelcol.processor.attributes (Loki label hint)
//              -> otelcol.exporter.loki -> loki.write -> Loki
//
// The staleness behavior (a down target's ping_duration_milliseconds shows an
// IMMEDIATE gap) is carried by the StaleNaN value the pinger emits while down; it
// flows verbatim through otelcol.exporter.prometheus -> remote_write. This was
// validated end-to-end (the "M1" spike) before the migration.

otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    metrics = [otelcol.exporter.prometheus.default.input]
    logs    = [otelcol.processor.attributes.loki_labels.input]
  }
}

// ---- metrics ----------------------------------------------------------------

otelcol.exporter.prometheus "default" {
  // Keep metric names verbatim: ping_up / ping_duration_milliseconds (no
  // _total/_ratio/unit suffixes).
  add_metric_suffixes = false
  // Suppress OTLP scope/target-info label & metric pollution so the series carry
  // no otel_scope_* labels and no target_info metric is produced.
  include_scope_info   = false
  include_scope_labels = false
  include_target_info  = false
  forward_to = [prometheus.relabel.strip.receiver]
}

prometheus.relabel "strip" {
  // OTLP conversion derives job (from resource service.name) and can derive
  // instance. Drop both so each series carries EXACTLY
  // {__name__, target, provider, family, role}.
  rule {
    action = "labeldrop"
    regex  = "job|instance"
  }
  forward_to = [prometheus.remote_write.mimir.receiver]
}

prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir:9009/api/v1/push"
  }
}

// ---- logs -------------------------------------------------------------------

otelcol.processor.attributes "loki_labels" {
  // Promote these log-record attributes to Loki stream labels so state-change
  // events are queryable as {event="state_change"} and by target/provider/...
  // (otelcol.exporter.loki reads the loki.attribute.labels hint and drops it).
  action {
    key    = "loki.attribute.labels"
    value  = "target, provider, family, role, event"
    action = "upsert"
  }
  // Emit the log body verbatim as the Loki line (matching the pre-migration
  // plain-text line) instead of the default JSON envelope. Hint consumed by the
  // OTLP->Loki translator; both loki.* hints are stripped from the output.
  action {
    key    = "loki.format"
    value  = "raw"
    action = "upsert"
  }
  output {
    logs = [otelcol.exporter.loki.default.input]
  }
}

otelcol.exporter.loki "default" {
  forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
