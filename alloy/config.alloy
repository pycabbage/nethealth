// Grafana Alloy relay for nethealth.
//
//   pinger --OTLP/gRPC(metrics+logs)--> Alloy
//     metrics: otelcol.receiver.otlp -> otelcol.exporter.prometheus
//              -> prometheus.relabel (drop job/instance) -> prometheus.remote_write -> Mimir
//     logs:    otelcol.receiver.otlp -> otelcol.processor.attributes (Loki label hint)
//              -> otelcol.exporter.loki -> loki.write -> Loki
//
// StaleNaN (a down target's ping_duration_milliseconds -> immediate gap) flows
// verbatim here to remote_write; see docs/adr/0004-staleness-over-otlp-stalenan.md.

otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    metrics = [otelcol.exporter.prometheus.default.input]
    logs    = [otelcol.processor.attributes.loki_labels.input]
  }
}

// ---- metrics ----------------------------------------------------------------

otelcol.exporter.prometheus "default" {
  // Keep metric names verbatim (no suffixes) and suppress scope/target_info
  // label & metric pollution; see docs/adr/0005-otlp-alloy-relay-and-label-hygiene.md.
  add_metric_suffixes = false
  include_scope_info   = false
  include_scope_labels = false
  include_target_info  = false
  forward_to = [prometheus.relabel.strip.receiver]
}

prometheus.relabel "strip" {
  // Drop job/instance (derived by OTLP conversion) so each series carries EXACTLY
  // {__name__, target, provider, family, role}; see docs/adr/0005-otlp-alloy-relay-and-label-hygiene.md.
  rule {
    action = "labeldrop"
    regex  = "job|instance"
  }
  forward_to = [prometheus.remote_write.mimir.receiver]
}

prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir:9009/api/v1/push"
  }
}

// ---- logs -------------------------------------------------------------------

otelcol.processor.attributes "loki_labels" {
  // Promote these attributes to Loki stream labels ({event="state_change"} etc.)
  // and emit the body as the raw line; see docs/adr/0005-otlp-alloy-relay-and-label-hygiene.md.
  action {
    key    = "loki.attribute.labels"
    value  = "target, provider, family, role, event"
    action = "upsert"
  }
  action {
    key    = "loki.format"
    value  = "raw"
    action = "upsert"
  }
  output {
    logs = [otelcol.exporter.loki.default.input]
  }
}

otelcol.exporter.loki "default" {
  forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
